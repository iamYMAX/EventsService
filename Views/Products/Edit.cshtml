@model EventsService.ViewModels.EditProductViewModel
@using EventsService.ViewModels // For ProductImageViewModel
@using System;

@{
    ViewData["Title"] = "Редактировать товар/услугу: " + Model.Name;
}

<h1>@ViewData["Title"]</h1>
<hr />
<div class="row">
    <div class="col-md-8"> @* Widened column for more fields *@
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Quantity" class="control-label">Количество</label>
                <input asp-for="Quantity" class="form-control" type="number" min="0" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="SKU" class="control-label">Артикул (SKU)</label>
                <input asp-for="SKU" class="form-control" />
                <span asp-validation-for="SKU" class="text-danger"></span>
            </div>

            <hr />
            <h4>Существующие изображения</h4>
            @if (Model.ExistingImages != null && Model.ExistingImages.Any())
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 mb-3">
                    @for (int i = 0; i < Model.ExistingImages.Count; i++)
                    {
                        <div class="col">
                            <div class="card h-100">
                                @{
                                    string imagePathValue = Model.ExistingImages[i].ImagePath;
                                    string finalImageUrl = ""; // Default to empty

                                    if (!string.IsNullOrEmpty(imagePathValue))
                                    {
                                        string cleanedPath = imagePathValue.Replace('\\', '/');

                                        if (string.IsNullOrEmpty(cleanedPath) || cleanedPath == "/")
                                        {
                                            finalImageUrl = ""; // Path is empty or just a slash, no valid image
                                        }
                                        else
                                        {
                                            Uri uri = null;
                                            if (Uri.TryCreate(cleanedPath, UriKind.Absolute, out uri) &&
                                                uri != null &&
                                                (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps))
                                            {
                                                // It's an absolute URI with http or https scheme
                                                if (string.Equals(uri.Host, "localhost", StringComparison.OrdinalIgnoreCase) || uri.Host.Contains("."))
                                                {
                                                    // Host is "localhost" or contains a dot (e.g., "example.com"). Valid absolute URL.
                                                    finalImageUrl = uri.ToString();
                                                }
                                                else
                                                {
                                                    // Host is a single segment (e.g., "uploads", "guid-filename") and not "localhost".
                                                    // Assume malformed URL; use its path part.
                                                    if (string.IsNullOrEmpty(uri.AbsolutePath) || uri.AbsolutePath == "/")
                                                    {
                                                        finalImageUrl = ""; // Path part is empty or root, no valid image
                                                    }
                                                    else
                                                    {
                                                        finalImageUrl = Url.Content("~/" + uri.AbsolutePath.TrimStart('/'));
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                // Not an absolute URI with http/https scheme, so treat as a relative path.
                                                // (This also handles cleanedPath that are just simple paths like "image.jpg" or "folder/image.jpg")
                                                finalImageUrl = Url.Content("~/" + cleanedPath.TrimStart('/'));
                                            }
                                        }
                                    }
                                }
                                <img src="@finalImageUrl" class="card-img-top" alt="@Model.ExistingImages[i].Caption" style="max-height: 150px; object-fit: contain; padding: 5px;" />
                                <div class="card-body">
                                    <p class="card-text small">@Model.ExistingImages[i].Caption</p>
                                    <input type="hidden" asp-for="ExistingImages[i].Id" />
                                    <input type="hidden" asp-for="ExistingImages[i].ImagePath" />
                                    <input type="hidden" asp-for="ExistingImages[i].Caption" />
                                    @* IsPrimary is handled by the radio button selection below for PrimaryImageId *@
                                    @* <input type="hidden" asp-for="ExistingImages[i].IsPrimary" /> *@

                                    <div class="form-check">
                                        <input asp-for="ExistingImages[i].IsMarkedForDeletion" type="checkbox" class="form-check-input" />
                                        <label asp-for="ExistingImages[i].IsMarkedForDeletion" class="form-check-label">Удалить это изображение</label>
                                    </div>
                                </div>
                                <div class="card-footer">
                                     <div class="form-check">
                                        <input type="radio" asp-for="PrimaryImageId" value="@Model.ExistingImages[i].Id" id="primaryImage_@Model.ExistingImages[i].Id" class="form-check-input" />
                                        <label for="primaryImage_@Model.ExistingImages[i].Id" class="form-check-label">Сделать основным</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p>Нет загруженных изображений для этого товара.</p>
            }
            <hr />

            <h4>Загрузить новые изображения</h4>
            <div class="form-group mb-3">
                <label asp-for="UploadedImages" class="control-label"></label>
                <input asp-for="UploadedImages" type="file" class="form-control" multiple />
                <span asp-validation-for="UploadedImages" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Сохранить изменения" class="btn btn-primary me-2" />
                <a asp-action="Index" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
    @* Removed the second col-md-6 that displayed Parameters, Characteristics, Properties directly from Product model *@
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
