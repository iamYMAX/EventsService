@model EventsService.Models.Product

@{
    ViewData["Title"] = Model.Name; // Set page title to product name
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8">
            @* Product Image Placeholder - if you add images later *@
            @* <div class="mb-3"> *@
            @*     <img src="~/images/placeholder.png" alt="@Model.Name" class="img-fluid rounded" style="max-height: 400px; display: block; margin-left: auto; margin-right: auto;" /> *@
            @* </div> *@

            <h1>@Html.DisplayFor(model => model.Name)</h1>
            <hr />

            <p class="lead">@Html.DisplayFor(model => model.Description)</p>

            @if (Model.Parameters != null && Model.Parameters.Any())
            {
                <h4 class="mt-4">Параметры</h4>
                <ul class="list-group list-group-flush">
                    @foreach (var param in Model.Parameters)
                    {
                        <li class="list-group-item"><strong>@param.Name:</strong> @param.Value</li>
                    }
                </ul>
            }

            @if (Model.Characteristics != null && Model.Characteristics.Any())
            {
                <h4 class="mt-4">Характеристики</h4>
                <ul class="list-group list-group-flush">
                    @foreach (var characteristic in Model.Characteristics)
                    {
                        <li class="list-group-item"><strong>@characteristic.Name:</strong> @characteristic.Value</li>
                    }
                </ul>
            }

            @if (Model.Properties != null && Model.Properties.Any())
            {
                <h4 class="mt-4">Свойства</h4>
                <ul class="list-group list-group-flush">
                    @foreach (var prop in Model.Properties)
                    {
                        <li class="list-group-item"><strong>@prop.Name:</strong> @prop.Value</li>
                    }
                </ul>
            }
        </div>

        <div class="col-lg-4">
            <div class="card sticky-top" style="top: 20px;"> @* Sticky card for price & add to cart *@
                <div class="card-body">
                    <h3 class="card-title">Цена: @Model.Price.ToString("C2")</h3>
                    <hr/>
                    <form asp-controller="Cart" asp-action="AddItemToCart" method="post">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <div class="form-group my-3">
                            <label for="quantity" class="form-label">Количество:</label>
                            <input type="number" name="quantity" value="1" min="1" class="form-control" style="width: 100px;" />
                        </div>
                        <button type="submit" class="btn btn-success btn-lg w-100">
                            <i class="bi bi-cart-plus-fill"></i> Добавить в корзину
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">&laquo; Назад к каталогу</a>
    </div>
</div>

@* Include Bootstrap Icons CDN if you want to use icons like bi-cart-plus-fill.
   This should ideally be in _Layout.cshtml if used globally.
   <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
*@
