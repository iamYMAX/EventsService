@model PaginatedList<EventsService.Models.Product>
@using EventsService.Utilities // For PaginatedList - ensure this is the correct namespace

@{
    ViewData["Title"] = "Каталог товаров и услуг";
}

<div class="text-center">
    <h1 class="display-4">@ViewData["Title"]</h1>
    <p class="lead">Ознакомьтесь с нашим ассортиментом товаров и услуг.</p>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-4 text-center" role="alert">
        В данный момент нет доступных товаров или услуг в каталоге. Пожалуйста, зайдите позже.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-3">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @* Placeholder for Product Image if you add it later: *@
                    @* <img src="placeholder.jpg" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;"> *@
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@Html.DisplayFor(modelItem => item.Name)</h5>
                        <p class="card-text flex-grow-1">@Html.DisplayFor(modelItem => item.Description)</p>
                        <p class="card-text"><strong>Цена:</strong> @item.Price.ToString("C2")</p>
                    </div>
                    <div class="card-footer bg-light border-top-0 text-center">
                        <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@item.Id" class="btn btn-primary">Подробнее</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Pagination Controls *@
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span> Предыдущая
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i">@i</a>
                </li>
            }

            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" aria-label="Next">
                    Следующая <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
}
