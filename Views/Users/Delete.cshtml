@model EventsService.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Удаление пользователя";
}

<h1>@ViewData["Title"]</h1>

@* Display safeguard errors from GET action, or other model errors *@
<div asp-validation-summary="All" class="text-danger mb-3"></div>

@if (ViewData.ModelState.IsValid) // Only show confirmation prompt if no safeguard errors from GET
{
    <h3 class="text-danger">Вы уверены, что хотите удалить этого пользователя?</h3>
}
else
{
    <h3 class="text-warning">Невозможно удалить этого пользователя по указанным выше причинам.</h3>
}

<div>
    <h4>@Model.UserName</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Roles)</dt>
        <dd class="col-sm-9">@string.Join(", ", Model.Roles)</dd>
    </dl>

    @if (ViewData.ModelState.IsValid) // Only show form and Delete button if no safeguard errors from GET
    {
        <form asp-action="Delete" class="mt-3">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Удалить" class="btn btn-danger me-2" />
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    }
    else
    {
        <a asp-action="Index" class="btn btn-secondary mt-3">Назад к списку</a>
    }
</div>
