@{
    ViewData["Title"] = "Календарь Заявок";
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales-all.min.js"></script>


<h1>@ViewData["Title"]</h1>

<div id="orderCalendar" style="max-width: 1100px; margin: 20px auto;"></div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('orderCalendar');
            var calendarEventsJson = @Html.Raw(ViewBag.CalendarEventsJson ?? "[]");

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth', // Common views: dayGridMonth, timeGridWeek, timeGridDay, listWeek
                locale: 'ru', // Set locale to Russian
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
                },
                events: calendarEventsJson,
                eventTimeFormat: { // Optional: format time on events
                    hour: '2-digit',
                    minute: '2-digit',
                    meridiem: false, // Use 24-hour format if true and no meridiem
                    hour12: false    // Use 24-hour format
                },
                displayEventEnd: true, // Display event end times if available
                // eventClick: function(info) {
                //     // info.event.url contains the URL set from the controller
                //     if (info.event.url) {
                //         window.location.href = info.event.url;
                //         info.jsEvent.preventDefault(); // Prevent browser from following link in current tab if you want to open in new tab or do something else
                //     }
                // }
                // The default behavior for events with a URL is to navigate to it, so eventClick might not be needed for simple navigation.
            });

            calendar.render();
        });
    </script>
}
