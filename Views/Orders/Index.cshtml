@model IEnumerable<EventsService.ViewModels.OrderViewModel>

@{
    ViewData["Title"] = "Заявки";
}

<h1>@ViewData["Title"]</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Manager"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary mt-2 mb-3">Создать новую заявку</a>
    </p>
}


<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID Заявки</th>
            <th>Клиент</th>
            <th>Ответственный сотрудник</th>
            <th>Дата заявки</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
@if (Model.Any())
{
    foreach (var item in Model) {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Id)</td>
                <td>@Html.DisplayFor(modelItem => item.ClientName)</td>
                <td>@Html.DisplayFor(modelItem => item.SalesRepresentativeDisplay)</td>
                <td>@Html.DisplayFor(modelItem => item.OrderDate)</td>
                <td>@Html.DisplayFor(modelItem => item.Status)</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Детали</a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                        }
                    </div>
                    @* Add more actions as needed, e.g., Assign, Complete *@
                </td>
            </tr>
    }
}
else
{
    <tr>
        <td colspan="6" class="text-center">Нет доступных заявок.</td>
    </tr>
}
    </tbody>
</table>
