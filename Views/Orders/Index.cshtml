@model IEnumerable<EventsService.Models.Order>

@{
    ViewData["Title"] = "Заявки";
}

<h1>@ViewData["Title"]</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Manager"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Создать новую заявку</a>
    </p>
}


<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().Id)</th>
            <th>@Html.DisplayNameFor(model => model.First().Client)</th>
            <th>@Html.DisplayNameFor(model => model.First().SalesRepresentative)</th>
            <th>@Html.DisplayNameFor(model => model.First().OrderDate)</th>
            <th>@Html.DisplayNameFor(model => model.First().Status)</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
@if (Model.Any())
{
    foreach (var item in Model) {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Id)</td>
                <td>@Html.DisplayFor(modelItem => item.Client.Name)</td>
                <td>@(item.SalesRepresentative != null ? Html.DisplayFor(modelItem => item.SalesRepresentative.UserName) : "Не назначен")</td>
                <td>@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@Html.DisplayFor(modelItem => item.Status)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Детали</a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                    }
                    @* Add more actions as needed, e.g., Assign, Complete *@
                </td>
            </tr>
    }
}
else
{
    <tr>
        <td colspan="6" class="text-center">Нет доступных заявок.</td>
    </tr>
}
    </tbody>
</table>
