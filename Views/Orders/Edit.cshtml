@model EventsService.ViewModels.EditOrderViewModel
@using EventsService.Models // For OrderStatus enum, though it's on the model

@{
    ViewData["Title"] = "Редактировать заявку #" + Model.OrderId;
}

<h1>@ViewData["Title"]</h1>
<hr />

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="OrderId" />

    <div class="row">
        <div class="col-md-6">
            <h4>Основные детали</h4>
            <div class="form-group mb-3">
                <label asp-for="ClientId" class="control-label"></label>
                @if (Model.CanEditClient)
                {
                    <select asp-for="ClientId" class="form-control" asp-items="Model.Clients"></select>
                    <span asp-validation-for="ClientId" class="text-danger"></span>
                }
                else
                {
                    <input type="text" readonly class="form-control-plaintext" value="@Model.ClientName" />
                    <input type="hidden" asp-for="ClientId" />
                }
            </div>

            <div class="form-group mb-3">
                <label asp-for="ScheduledServiceDateTime" class="control-label"></label>
                @if (Model.CanEditOrderDate) // Using CanEditOrderDate as a proxy for now (Admins)
                {
                    <input asp-for="ScheduledServiceDateTime" class="form-control" type="datetime-local" />
                    <span asp-validation-for="ScheduledServiceDateTime" class="text-danger"></span>
                }
                else
                {
                    <input type="text" readonly class="form-control-plaintext" value="@(Model.ScheduledServiceDateTime.HasValue ? Model.ScheduledServiceDateTime.Value.ToString("g") : "Не указано")" />
                    <input type="hidden" asp-for="ScheduledServiceDateTime" />
                }
            </div>

            <div class="form-group mb-3">
                <label asp-for="SalesRepresentativeId" class="control-label"></label>
                @if (Model.CanEditSalesRepresentative)
                {
                    <select asp-for="SalesRepresentativeId" class="form-control" asp-items="Model.SalesRepresentatives">
                        <option value="">-- Не назначен --</option>
                    </select>
                    <span asp-validation-for="SalesRepresentativeId" class="text-danger"></span>
                }
                else
                {
                    <input type="text" readonly class="form-control-plaintext" value="@Model.SalesRepresentativeName" />
                    <input type="hidden" asp-for="SalesRepresentativeId" />
                }
            </div>

            <div class="form-group mb-3">
                <label asp-for="OrderDate" class="control-label"></label>
                @if (Model.CanEditOrderDate)
                {
                    <input asp-for="OrderDate" class="form-control" />
                    <span asp-validation-for="OrderDate" class="text-danger"></span>
                }
                else
                {
                    <input type="text" readonly class="form-control-plaintext" value="@Model.OrderDate.ToString("g")" />
                    <input type="hidden" asp-for="OrderDate" />
                }
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label"></label>
                @if (Model.CanEditStatus)
                {
                    <select asp-for="Status" class="form-control" asp-items="Model.Statuses"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                }
                else
                {
                    <input type="text" readonly class="form-control-plaintext" value="@Model.Status.ToString()" />
                    <input type="hidden" asp-for="Status" />
                }
            </div>
        </div>

        <div class="col-md-6">
            <h4>Товары/Услуги в заявке</h4>
            @if (Model.CanEditOrderItems)
            {
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Продукт/Услуга</th>
                                <th>Количество</th>
                                <th>Цена за ед.</th>
                                <th>Сумма</th>
                                @if(Model.CanDeleteOrderItems) {
                                    <th>Удалить</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.OrderItems.Count; i++)
                            {
                                <tr>
                                    <td>
                                        @Html.HiddenFor(m => m.OrderItems[i].Id)
                                        @Html.HiddenFor(m => m.OrderItems[i].ProductId)
                                        @Html.DisplayFor(m => m.OrderItems[i].ProductName)
                                    </td>
                                    <td>
                                        <input asp-for="OrderItems[i].Quantity" class="form-control form-control-sm" style="width: 80px;" type="number" min="1" />
                                        <span asp-validation-for="OrderItems[i].Quantity" class="text-danger"></span>
                                    </td>
                                    <td>
                                        @* For simplicity, price at time of order is not editable here directly for existing items. Could be made editable if needed. *@
                                        @* If editable: <input asp-for="OrderItems[i].PriceAtTimeOfOrder" class="form-control form-control-sm" style="width: 100px;" /> *@
                                        @Html.DisplayFor(m => m.OrderItems[i].PriceAtTimeOfOrder, "{0:C2}")
                                        @Html.HiddenFor(m => m.OrderItems[i].PriceAtTimeOfOrder) @* Still need to post it back *@
                                        <span asp-validation-for="OrderItems[i].PriceAtTimeOfOrder" class="text-danger"></span>
                                    </td>
                                    <td>
                                        @Model.OrderItems[i].LineTotal.ToString("C2")
                                    </td>
                                    @if(Model.CanDeleteOrderItems) {
                                        <td>
                                            <input asp-for="OrderItems[i].IsMarkedForDeletion" type="checkbox" class="form-check-input" />
                                            <label asp-for="OrderItems[i].IsMarkedForDeletion" class="form-check-label">Отметить</label>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.CanAddOrderItems)
                {
                    <div class="mt-3">
                        <h5>Добавить новые товары/услуги</h5>
                        <div class="form-group mb-2">
                            <label asp-for="SelectedProductIds" class="control-label"></label>
                            <select asp-for="SelectedProductIds" class="form-control" asp-items="Model.AvailableProducts" multiple="multiple" size="5"></select>
                            <small class="form-text text-muted">Удерживайте Ctrl (или Cmd на Mac) для выбора нескольких позиций. Новые товары будут добавлены с количеством 1 и текущей ценой из каталога.</small>
                        </div>
                    </div>
                }
            }
            else // User cannot edit order items at all
            {
                <p>Список товаров/услуг:</p>
                <ul>
                    @foreach (var item in Model.OrderItems)
                    {
                        <li>@item.ProductName - @item.Quantity шт. по @item.PriceAtTimeOfOrder.ToString("C2")</li>
                    }
                </ul>
                @if (!Model.OrderItems.Any())
                {
                    <p>Нет товаров/услуг в этой заявке.</p>
                }
            }
        </div>
    </div>

    <div class="form-group mt-4">
        <input type="submit" value="Сохранить изменения" class="btn btn-primary me-2" />
        <a asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-secondary">Отмена и назад к деталям</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Basic script to update line totals if quantities change - for better UX, not strictly required for functionality.
        // This would require more setup (giving IDs to elements) for a robust implementation.
        // For now, line totals are based on model values and will update on server roundtrip.
    </script>
}
