@using Microsoft.AspNetCore.Identity
@using EventsService.Models
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventsService</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EventsService.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">EventsService</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            // Главная страница (Home Page) - Visible to all authenticated users
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Главная страница</a>
                            </li>

                            // Заявки (Orders) - Visible to Admin, Manager, SalesRepresentative, Client
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("SalesRepresentative") || User.IsInRole("Client"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Orders" asp-action="Index">Заявки</a>
                                </li>
                            }

                            // Сотрудники (Employees/Users) - Visible to Admin
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Users" asp-action="Index">Сотрудники</a>
                                </li>
                            }

                            // Клиенты (Clients) - Visible to Admin, Manager
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Clients" asp-action="Index">Клиенты</a>
                                </li>
                            }

                            // Связи Пользователь-Клиент (User-Client Links) - Visible to Admin
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="UserClientLinking" asp-action="Index">Связи Пользователь-Клиент</a>
                                </li>
                            }

                            // Услуги и товары (Services and Products) - Visible to Admin, Manager
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index">Услуги и товары</a>
                                </li>
                            }

                            // Чек-листы (Checklists) - Visible to Admin, Manager, SalesRepresentative
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("SalesRepresentative"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Checklists" asp-action="Index">Чек-листы</a>
                                </li>
                            }

                            // Статистика (Statistics / Order Calendar) - Visible to Admin, Manager, SalesRepresentative, Client
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("SalesRepresentative") || User.IsInRole("Client"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Statistics" asp-action="Index">Статистика</a>
                                </li>
                            }

                            // Настройки (Settings) - Visible to Admin
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Settings" asp-action="Index">Настройки</a>
                                </li>
                            }
                        }
                        else
                        {
                            // Optionally, add links for non-authenticated users here if needed,
                            // besides what _LoginPartial will show. For example, a public "About" page.
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                             <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                        }
                    </ul>

                    @* This ul will hold items on the right, before LoginPartial *@
                    <ul class="navbar-nav ms-auto"> @* ms-auto pushes this group to the right *@
                        <li class="nav-item d-flex align-items-center me-2"> @* me-2 for spacing from cart icon *@
                            <div class="theme-switch-wrapper" title="Переключить тему">
                                <label class="theme-switch" for="themeSwitchCheckbox">
                                    <input type="checkbox" id="themeSwitchCheckbox" />
                                    <div class="slider round"></div>
                                </label>
                            </div>
                            <span class="d-lg-none ms-1">Тема</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Cart" asp-action="Index" title="Корзина">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-cart-fill" viewBox="0 0 16 16">
                                    <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                                </svg>
                                <span class="d-lg-none ms-2">Корзина</span> @* Text for collapsed menu *@
                                @* Item count badge can be added here later, e.g., <span class="badge bg-danger ms-1" id="cartItemCount">0</span> *@
                            </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - EventsService - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
