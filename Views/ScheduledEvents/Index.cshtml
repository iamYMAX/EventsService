@model IEnumerable<EventsService.ViewModels.ScheduledEventViewModel>

@{
    ViewData["Title"] = "Расписание событий";
}

<h1>@ViewData["Title"]</h1>

<p>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("SalesRepresentative"))
    {
        <a asp-action="Create" class="btn btn-primary mt-2 mb-3">Создать новое событие</a>
    }
</p>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        Нет запланированных событий для отображения.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.First().Title)</th>
                <th>@Html.DisplayNameFor(model => model.First().StartTime)</th>
                <th>@Html.DisplayNameFor(model => model.First().EndTime)</th>
                <th>@Html.DisplayNameFor(model => model.First().UserName)</th>
                <th>@Html.DisplayNameFor(model => model.First().ClientName)</th>
                <th>@Html.DisplayNameFor(model => model.First().OrderId)</th>
                <th>@Html.DisplayNameFor(model => model.First().Location)</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Title)</td>
                    <td>@item.StartTime.ToString("g")</td>
                    <td>@item.EndTime.ToString("g")</td>
                    <td>@Html.DisplayFor(modelItem => item.UserName)</td>
                    <td>@Html.DisplayFor(modelItem => item.ClientName)</td>
                    <td>@Html.DisplayFor(modelItem => item.OrderId)</td>
                    <td>@Html.DisplayFor(modelItem => item.Location)</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">Детали</a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager") || (User.IsInRole("SalesRepresentative") /* && item.UserId == currentUserId - check in controller for edit/delete rights */ ))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Изменить</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Удалить</a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
