@model EventsService.ViewModels.ScheduledEventViewModel

@{
    ViewData["Title"] = "Удалить событие: " + Model.Title;
}

<h1>@ViewData["Title"]</h1>
<h3 class="text-danger">Вы уверены, что хотите удалить это событие?</h3>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Title)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Title)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StartTime)</dt>
        <dd class="col-sm-9">@Model.StartTime.ToString("g")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EndTime)</dt>
        <dd class="col-sm-9">@Model.EndTime.ToString("g")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UserName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.UserName)</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Удалить" class="btn btn-danger me-2" />
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>
