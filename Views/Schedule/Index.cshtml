@model IEnumerable<EventsService.ViewModels.OrderScheduleViewModel>

@{
    ViewData["Title"] = "Расписание Заявок";
}

<h1>@ViewData["Title"]</h1>

@if (!Model.Any())
{
    <div class="alert alert-info mt-3" role="alert">
        Нет запланированных заявок для отображения.
    </div>
}
else
{
    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.First().ScheduledServiceDateTime)</th>
                <th>@Html.DisplayNameFor(model => model.First().OrderId)</th>
                <th>@Html.DisplayNameFor(model => model.First().ClientName)</th>
                <th>@Html.DisplayNameFor(model => model.First().SalesRepresentativeName)</th>
                <th>@Html.DisplayNameFor(model => model.First().OrderStatus)</th>
                <th>@Html.DisplayNameFor(model => model.First().OrderSummary)</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ScheduledServiceDateTime.ToString("g")</td>
                    <td>
                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@item.OrderId">
                            Заявка #@item.OrderId
                        </a>
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.ClientName)</td>
                    <td>@Html.DisplayFor(modelItem => item.SalesRepresentativeName)</td>
                    <td>@Html.DisplayFor(modelItem => item.OrderStatus)</td>
                    <td>@Html.DisplayFor(modelItem => item.OrderSummary)</td>
                    <td>
                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-info">Детали заявки</a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager")) // Only Admins/Managers can edit orders from schedule view for now
                        {
                            <a asp-controller="Orders" asp-action="Edit" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-primary">Изменить заявку</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
